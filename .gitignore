# binário do app. O padrão precisa da barra: sem ela, "acessos" casaria
# também com cmd/acessos/ e o diretório do programa ficaria de fora.
/acessos
# binários dos comandos de teste manual de cada protocolo
/initest
/rdpview
/sftptest
/sshtest
/sshview
/vnctest
/vncview
# artefatos de empacotamento
/build/
# recurso do Windows (ícone + versão), gerado por scripts/build-windows.sh
/cmd/acessos/recurso_windows.syso
/.flatpak-builder/
# vendor é gerado pelo build.sh (go mod vendor) antes de empacotar: existe
# para o build do Flatpak rodar OFFLINE, não para versionar 31 MB de
# código de terceiros.
/vendor/
